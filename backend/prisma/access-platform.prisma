model DeliveryPlatformRule {
  id            String       @id @default(uuid()) @db.Uuid
  domain        String       @unique @db.VarChar(253)
  province      String?      @db.VarChar(64)
  platformName  String       @db.VarChar(128)
  mode          DeliveryMode @default(MANUAL)
  parseRules    Json         @default("{}")
  enabled       Boolean      @default(false)
  successCount  Int          @default(0)
  failCount     Int          @default(0)
  lastSuccessAt DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?    @db.Timestamptz(3)
}

// v1.1 预留：不创建门户接口，不发放真实访问令牌。
model ClientAccess {
  id          String             @id @default(uuid()) @db.Uuid
  caseId      String             @db.Uuid
  casePartyId String             @db.Uuid
  grantedBy   String             @db.Uuid
  /// @sensitive @hashed 只存访问令牌 SHA-256 摘要，禁止持久化令牌原文。
  tokenHash   Bytes              @unique @db.ByteA
  status      ClientAccessStatus @default(PENDING)
  expiresAt   DateTime           @db.Timestamptz(3)
  revokedAt   DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?          @db.Timestamptz(3)

  case    Case              @relation(fields: [caseId], references: [id], onDelete: Restrict)
  party   CaseParty         @relation(fields: [casePartyId, caseId], references: [id, caseId], onDelete: Restrict)
  grantor User              @relation(fields: [grantedBy], references: [id], onDelete: Restrict)
  logs    ClientAccessLog[]

  @@unique([id, caseId])
  @@index([caseId, status])
}

model ClientAccessLog {
  id             String    @id @default(uuid()) @db.Uuid
  clientAccessId String    @db.Uuid
  caseId         String    @db.Uuid
  action         String    @db.VarChar(128)
  resourceType   String    @db.VarChar(64)
  resourceId     String?   @db.Uuid
  succeeded      Boolean
  ip             String?   @db.Inet
  occurredAt     DateTime  @default(now()) @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  access ClientAccess @relation(fields: [clientAccessId, caseId], references: [id, caseId], onDelete: Restrict)
  case   Case         @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([clientAccessId, occurredAt])
}
