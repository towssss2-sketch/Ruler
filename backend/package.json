{
  "name": "ruler-backend",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "start": "node --env-file=../.env dist/main.js",
    "start:dev": "node --env-file=../.env --watch dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "node --env-file=../.env node_modules/prisma/build/index.js validate",
    "db:migrate": "node --env-file=../.env node_modules/prisma/build/index.js migrate deploy",
    "test:integration": "node --env-file=../.env ../scripts/integration-check.mjs",
    "test:database": "node --env-file=../.env ../scripts/test-database.mjs"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@prisma/client": "6.19.3",
    "pino": "9.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.23",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.25",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.4.0"
  }
}
